{
  "name": "milano-liscio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline bike routing for Milan that avoids sett paving and tram rails (iPhone PWA).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:fetch": "tsx scripts/01-fetch-osm.ts",
    "data:audit": "tsx scripts/02-audit.ts",
    "data:graph": "tsx scripts/03-build-graph.ts",
    "data:basemap": "tsx scripts/05-build-basemap.ts",
    "data:manifest": "tsx scripts/06-build-manifest.ts",
    "data:build": "pnpm data:fetch && pnpm data:graph && pnpm data:geocoder && pnpm data:basemap && pnpm data:manifest",
    "route": "tsx scripts/route-cli.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "icons": "tsx scripts/make-icons.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.e2e.json",
    "data:geocoder": "tsx scripts/04-build-geocoder.ts",
    "deploy": "tsx scripts/deploy.ts",
    "data:refresh": "pnpm data:fetch --refresh && pnpm data:graph && pnpm data:geocoder && pnpm data:basemap --refresh && pnpm data:manifest"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "idb": "^8.0.4",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-precaching": "^7.4.1",
    "zustand": "^5.1.0"
  }
}
