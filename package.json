{
  "name": "milano-liscio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline bike routing for Milan that avoids sett paving and tram rails (iPhone PWA).",
  "scripts": {
    "data:fetch": "tsx scripts/01-fetch-osm.ts",
    "data:audit": "tsx scripts/02-audit.ts",
    "data:graph": "tsx scripts/03-build-graph.ts",
    "data:build": "pnpm data:fetch && pnpm data:graph",
    "route": "tsx scripts/route-cli.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
